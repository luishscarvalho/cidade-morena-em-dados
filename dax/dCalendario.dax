dCalendario =
ADDCOLUMNS(
    CALENDAR(
        DATE(YEAR(MIN(fDespesas[dataempenho])), 1, 1),
        DATE(YEAR(MAX(fDespesas[dataempenho])), 12, 31)
    ),
    "Ano", YEAR([Date]),
    "MesNum", MONTH([Date]),
    "Mes", FORMAT([Date], "mmm"),
    "Trimestre", "T" & QUARTER([Date]),
    "AnoMes", FORMAT([Date], "yyyy-mm")
)
